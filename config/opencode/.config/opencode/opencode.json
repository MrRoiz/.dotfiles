{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.dotfiles/agent/instructions/PRINCIPLES.md",
    "~/.dotfiles/agent/instructions/ORGANIZATION.md",
    "~/.dotfiles/agent/instructions/MODULARITY.md",
    "~/.dotfiles/agent/instructions/PATTERNS.md",
    "~/.dotfiles/agent/instructions/CONFIGURATION.md",
    "~/.dotfiles/agent/instructions/CHANGES.md",
    "~/.dotfiles/agent/instructions/GIT.md",
    "~/.dotfiles/agent/instructions/NOTIFY.md",
    "~/.dotfiles/agent/instructions/COMMUNICATION.md"
  ],
  "skills": [
    "~/.dotfiles/agent/skills"
  ],
  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "~/.aws/credentials", "effect": "deny" },
    { "action": "edit", "resource": "~/.aws/credentials", "effect": "deny" },
    { "action": "read", "resource": "~/.config/gh/hosts.yml", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/gh/hosts.yml", "effect": "deny" },
    { "action": "read", "resource": "~/.config/github-copilot/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/github-copilot/*", "effect": "deny" },
    { "action": "read", "resource": "~/.config/ntfy-sender/config.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/ntfy-sender/config.json", "effect": "deny" },
    { "action": "read", "resource": "~/.claude/.credentials.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.claude/.credentials.json", "effect": "deny" },
    { "action": "read", "resource": "~/.local/share/keyrings/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.local/share/keyrings/*", "effect": "deny" },
    { "action": "read", "resource": "~/.megaCmd/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.megaCmd/*", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      "chrome": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--executable-path=/usr/bin/chromium",
          "--no-usage-statistics"
        ]
      }
    }
  }
}
