{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "chrome": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--executable-path=/usr/bin/chromium",
          "--no-usage-statistics"
        ]
      }
    }
  }
}
