{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.dotfiles/agent-instructions/NOTIFY.md",
    "~/.dotfiles/agent-instructions/PRINCIPLES.md"
  ],
  "mcp": {
    "servers": {
      "chrome": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--executable-path=/usr/bin/chromium",
          "--no-usage-statistics"
        ]
      }
    }
  }
}
