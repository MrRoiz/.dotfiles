#!/usr/bin/env bash
# Toggle Omarchy's per-monitor workspaces (port of omacom/omarchy#16213).
#
# The opt-out is read by the local default/hypr/monitor-workspaces.lua
# override; see KNOWN-GAPS.md. Remove this command once #16213 ships.
#
# Usage: omarchy-toggle-monitor-workspaces [toggle|on|off]
#
# `off` also renames workspaces left on per-monitor ids (12 -> 2) so the bar
# labels and the number keys agree with the global ids.

set -euo pipefail

FLAG="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/no-monitor-workspaces"
ENABLED=on
[[ -f $FLAG ]] && ENABLED=off

if (( $# > 1 )); then
  echo "Usage: omarchy-toggle-monitor-workspaces [toggle|on|off]" >&2
  exit 1
fi

case ${1:-toggle} in
  toggle)
    if [[ $ENABLED == "on" ]]; then
      NEW=off
    else
      NEW=on
    fi
    ;;
  on | off) NEW=$1 ;;
  *)
    echo "Usage: omarchy-toggle-monitor-workspaces [toggle|on|off]" >&2
    exit 1
    ;;
esac

set_mode() {
  if [[ $1 == "off" ]]; then
    mkdir -p "$(dirname "$FLAG")"
    touch "$FLAG"
  else
    rm -f "$FLAG"
  fi
}

in_use() {
  hyprctl workspaces -j | jq -e --argjson slot "$1" 'any(.[]; .id == $slot)' >/dev/null
}

# Per-monitor mode puts a monitor's slots on ids above 10 and disabling keeps
# them, so a workspace the bar labels "2" can still be id 12 while SUPER + 2
# targets a global 2 that does not exist yet. Rename those workspaces back into
# 1-10, keeping their windows and monitors.
renumber_global() {
  local id slot expression
  local -a ids
  mapfile -t ids < <(hyprctl workspaces -j | jq -r '.[] | select(.id > 10) | .id')

  for id in "${ids[@]}"; do
    slot=$(( (id - 1) % 10 + 1 ))
    if in_use "$slot"; then
      echo "warning: workspace $id kept; workspace $slot is already in use" >&2
      continue
    fi
    expression="hl.dsp.workspace.change_id({ workspace = \"$id\", id = $slot })"
    if ! hyprctl dispatch "$expression" >/dev/null; then
      echo "warning: could not renumber workspace $id" >&2
    fi
  done
}

set_mode "$NEW"
if ! hyprctl reload >/dev/null; then
  set_mode "$ENABLED"
  echo "Could not reload Hyprland; workspace numbering was not changed" >&2
  exit 1
fi

if [[ $NEW == "off" ]]; then
  renumber_global
fi

omarchy-shell -q omarchy.workspaces refresh >/dev/null 2>&1 || true

if [[ $NEW == "on" ]]; then
  omarchy-notification-send -g 󱂬 "Per monitor workspaces enabled"
else
  omarchy-notification-send -g 󱂬 "Global workspace numbering enabled"
fi
