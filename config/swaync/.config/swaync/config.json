{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": true,
  "cssPriority": "highest",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "relative-timestamps": true,
  "control-center-width": 500,
  "control-center-height": 600,
  "notification-window-width": 500,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "No Notifications",
  "script-fail-notify": true,
  "widgets": [
    "inhibitors",
    "title",
    "dnd",
    "buttons-grid#system",
    "title#profiles",
    "buttons-grid#profiles",
    "notifications"
  ],
  "widget-config": {
    "inhibitors": {
      "text": "Inhibitors",
      "button-text": "Clear All",
      "clear-all-button": true
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "buttons-grid#system": {
      "buttons-per-row": 6,
      "actions": [
        {
          "label": "󰖩",
          "type": "toggle",
          "command": "sh -c '$HOME/.config/swaync/toggles.sh toggle wifi'",
          "update-command": "sh -c '$HOME/.config/swaync/toggles.sh state wifi'"
        },
        {
          "label": "󰅂",
          "command": "sh -c 'swaync-client -cp; better-control -w -m'"
        },
        {
          "label": "",
          "type": "toggle",
          "command": "sh -c '$HOME/.config/swaync/toggles.sh toggle bt'",
          "update-command": "sh -c '$HOME/.config/swaync/toggles.sh state bt'"
        },
        {
          "label": "󰅂",
          "command": "sh -c 'swaync-client -cp; better-control -b -m'"
        },
        {
          "label": "󰍬",
          "type": "toggle",
          "command": "sh -c '$HOME/.config/swaync/toggles.sh toggle mic'",
          "update-command": "sh -c '$HOME/.config/swaync/toggles.sh state mic'"
        },
        {
          "label": "󰅂",
          "command": "sh -c 'swaync-client -cp; pavucontrol --tab 4'"
        }
      ]
    },
    "title#profiles": {
      "text": "Power Profiles",
      "clear-all-button": false
    },
    "buttons-grid#profiles": {
      "buttons-per-row": 3,
      "actions": [
        {
          "label": "",
          "command": "sh -c '$HOME/.config/swaync/toggles.sh set-profile power-saver'"
        },
        {
          "label": "",
          "command": "sh -c '$HOME/.config/swaync/toggles.sh set-profile balanced'"
        },
        {
          "label": "",
          "command": "sh -c '$HOME/.config/swaync/toggles.sh set-profile performance'"
        }
      ]
    }
  }
}